# ---------------------------------------------------------------------------
# Product identity (white-label)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRODUCT_NAME=GrowthPilot
NEXT_PUBLIC_PRODUCT_TAGLINE="Marketing Strategy & Diagnostic Workbench"

# ---------------------------------------------------------------------------
# Local demo mode: no Firebase needed. Single demo user, data in .data/demo-db.json.
# Never enable in production.
# ---------------------------------------------------------------------------
GROWTHPILOT_DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Firebase web app (public config)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
# Recommended in production: your own site domain (e.g. growth-pilot-azure.vercel.app).
# The app proxies /__/auth/* to Firebase, so Google sign-in stays same-origin.
# Also add https://<your-domain>/__/auth/handler as an authorized redirect URI
# on the OAuth client in Google Cloud Console → APIs & Services → Credentials.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server only). Omit on Cloud Run/Functions to use ADC.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Credential encryption (required outside demo mode).
# 32-byte keys, base64. The LAST key encrypts; earlier keys still decrypt (rotation).
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEYS=v1:REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Optional platform-level AI provider used only when an organization has none.
# ---------------------------------------------------------------------------
# PLATFORM_AI_PROVIDER=anthropic   # openai | anthropic | gemini | openrouter
# PLATFORM_AI_API_KEY=

# Optional guard rails (GrowthPilot's own limits; AI providers have separate quotas).
# Answered AI requests per workspace per day, 0 = unlimited (default 500 on the free plan).
# AI_DAILY_REQUEST_LIMIT=500
# Open cases per workspace, 0 = unlimited (default 3 on the free plan).
# MAX_ACTIVE_CASES=3
